# ===== Project =====
PROJECT_NAME=myapp

# ===== Database (dipakai docker-compose) =====
DB_USER=postgres
DB_PASSWORD=ganti_password_ini
DB_NAME=myapp_db
DB_PORT=5433        # pakai 5433 supaya tidak bentrok dengan Postgres lokal (default 5432)

# ===== Prisma =====
# Harus sinkron dengan nilai DB_* di atas
DATABASE_URL="postgresql://postgres:ganti_password_ini@localhost:5433/myapp_db"